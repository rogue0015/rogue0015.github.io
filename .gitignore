# Local-only project files (never published)
CLAUDE.md
docs/

# Editor / OS noise
.vscode/
.DS_Store
Thumbs.db

# Local-only agent memory notes
memory/

# Blog post sources stay local — only the mandatory template is versioned.
# Generated post .html, blogs/index.html, and sitemap.xml are still committed.
blogs/*.md
!blogs/_post-template.md

# Build tooling stays local — only its generated output is published.
scripts/

# Editable content data with a safe static-HTML fallback stays local.
# data/projects.json is NOT listed here — it's the live, no-fallback source
# for the Projects panel and must stay tracked. content.sample.json and
# speaker.sample.json (structure-only) are still committed as reference.
data/content.json
data/speaker.json
